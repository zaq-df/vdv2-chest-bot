# Local default. On Railway, create a Volume mounted at /data and set DATA_DIR=/data.
DATA_DIR=./data

# Optional chest behavior
CHEST_MAX_OPENS=5
CHEST_COIN_MIN=1
CHEST_COIN_MAX=6
CHEST_TIMEOUT_MINUTES=5
CHEST_AUTO_MINUTES=120
SPAWN_CHEST_ON_START=false

# Optional visuals and roles
CHEST_IMAGE_URL=
CHEST_IMAGE_PATH=./assets/vdv2chest.png
VDV2_TAG_ROLE_ID=
BOOSTER_ROLE_ID=
COIN_EMOJI=🏛️
